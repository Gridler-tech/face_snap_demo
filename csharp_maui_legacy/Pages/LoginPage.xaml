<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PhotoColumnApp.LoginPage"
             xmlns:viewmodel="clr-namespace:PhotoColumnApp.ViewModels"
             x:DataType="viewmodel:LoginViewModel"
             Shell.NavBarIsVisible="False">

    <Grid BackgroundColor="#c3c3c3">
        <Grid.RowDefinitions>
            <RowDefinition Height="{OnPlatform iOS='2*', Android='1*', WinUI='0.5*', MacCatalyst='0.5*'}" />
            <RowDefinition Height="{OnPlatform iOS='2*', Android='1.5*', WinUI='2*', MacCatalyst='2*'}" />
            <RowDefinition Height="{OnPlatform iOS='5*', Android='5*', WinUI='5*', MacCatalyst='5*'}" />
            <RowDefinition Height="{OnPlatform iOS='2*', Android='2*', WinUI='0.5*', MacCatalyst='0.5*'}" />
            <RowDefinition Height="{OnPlatform iOS='1*', Android='1*', WinUI='1*', MacCatalyst='1*'}" />
            <RowDefinition Height="{OnPlatform iOS='50', Android='50', WinUI='50', MacCatalyst='50'}" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{OnPlatform iOS='1*', Android='1*', WinUI='0.5*', MacCatalyst='0.5*'}" />
            <ColumnDefinition Width="{OnPlatform iOS='3*', Android='3*', WinUI='3*', MacCatalyst='3*'}" />
            <ColumnDefinition Width="{OnPlatform iOS='3*', Android='3*', WinUI='3*', MacCatalyst='3*'}" />
            <ColumnDefinition Width="{OnPlatform iOS='1*', Android='1*', WinUI='3*', MacCatalyst='3*'}" />
        </Grid.ColumnDefinitions>
        <Frame
            x:Name="ContentBG"
            BackgroundColor="{OnPlatform iOS='#00FFFFFF', Android='#00FFFFFF', WinUI='#AAFFFFFF', MacCatalyst='#AAFFFFFF'}"
            BorderColor="#00000000"
            CornerRadius="20"
            Grid.Column="1"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Grid.RowSpan="2"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"/>
        <Label 
            Text="Gridler Face Capture Demo application"
            FontSize="Large"
            Grid.Column="1"
            Grid.Row="1"
            Grid.ColumnSpan="{OnPlatform iOS='2', Android='2', WinUI='1', MacCatalyst='1'}"
            Margin="{OnPlatform iOS='0,20,0,0', Android='5, 10', WinUI='50,50,0,0', MacCatalyst='50,50,0,0'}"/>

        <Label 
            Text="Welcome to our Face capture demo. This application shows all capabilities and settings of our 6-camera face solution."
            FontSize="Small"
            Grid.Column="1"
            Grid.Row="2"
            Grid.ColumnSpan="{OnPlatform iOS='2', Android='2', WinUI='1', MacCatalyst='1'}"
            Margin="{OnPlatform iOS='0,20,0,0', Android='5, 10', WinUI='50,30,0,0', MacCatalyst='50,30,0,0'}"/>

        <Image
            Source="logo_gridler.png"
            Aspect="{OnPlatform iOS='AspectFill', Android='AspectFit', WinUI='AspectFit', MacCatalyst='AspectFit'}"
            Margin="{OnPlatform iOS='0,20,0,0', Android='10,30,10,0', WinUI='10,0,20,0', MacCatalyst='10,0,20,0'}"
            Grid.Column="{OnPlatform iOS='1', Android='1', WinUI='2', MacCatalyst='2'}"
            Grid.ColumnSpan="{OnPlatform iOS='2', Android='2', WinUI='1', MacCatalyst='1'}"
            Grid.RowSpan="2"
            Grid.Row="{OnPlatform iOS='1', Android='2', WinUI='1', MacCatalyst='1'}" />

        <Button x:Name="StartButton"
            Text="Start"
            FontAttributes="Bold"
            Command="{Binding NavigateCommand}"
            CommandParameter="//Home"
            HorizontalOptions="Fill"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Grid.Row="4"
            Margin="{OnPlatform iOS='0,20,0,0', Android='5,10,0,0', WinUI='0,0,0,10', MacCatalyst='0,0,0,10'}"/>

        <Image
            Source="{OnPlatform iOS='transparent.png', Android='transparent.png', WinUI='login_page_kiosk.png', MacCatalyst='login_page_kiosk.png'}"
            Aspect="{OnPlatform iOS='AspectFill', Android='AspectFill', WinUI='AspectFill', MacCatalyst='AspectFill'}"
            HorizontalOptions="End"
            VerticalOptions="Center"
            Grid.Column="4"
            Grid.ColumnSpan="4"
            Grid.RowSpan="6"/>
    </Grid>

</ContentPage>
